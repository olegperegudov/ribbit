{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ribbit",
  "version": "0.7.90",
  "identifier": "com.ribbit.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Ribbit",
        "width": 400,
        "height": 440,
        "resizable": true,
        "center": true,
        "alwaysOnTop": false,
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCNzU5RDcyNjJFQzY5QjkKUldTNWFleGljcDExdTVwSXd0M01odzRpcnVBQk1EejlZd0NzSTBlVFJGVDJkY1FZRFhzZ3lYY1oK",
      "endpoints": [
        "https://github.com/olegperegudov/ribbit/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": "v1Compatible",
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  }
}